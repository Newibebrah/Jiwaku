---
const { siteData = {} } = Astro.props;
const footerText = siteData.footer_text || 'Placeholder: kalimat singkat tentang JIWAKU dan karya Anda.';
---

<footer class="site-footer">
    <div class="wrapper">
        <div class="footer-inner">
            <div class="footer-brand">
                <a class="navbar-logo" href="/">{siteData.title || 'JIWAKU'}<span>.</span></a>
                <p>{footerText}</p>
            </div>
            <div class="footer-col">
                <h4>Explore</h4>
                <div class="footer-links">
                    <a href="/">Home</a>
                    <a href="/poem">Poem</a>
                    <a href="/photography">Photography</a>
                    <a href="/writing">Writing</a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Connect</h4>
                <div class="footer-links">
                    <a href="/contact">Contact</a>
                    <a href="/">About</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; {new Date().getFullYear()} {siteData.title || 'JIWAKU'}. All rights reserved.</p>
            <p>Crafted with care</p>
        </div>
    </div>
</footer>
