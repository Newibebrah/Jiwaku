---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const photos = (await getCollection('photos')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmtDate = (d) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout page="photography" title="Photography" description="Galeri fotografi dari JIWAKU.">
    <main class="wrapper">
        <section class="page-hero reveal">
            <p class="book-kicker">Galeri</p>
            <h1>Photography<span class="text-accent">.</span></h1>
            <p>Placeholder: deskripsi singkat halaman fotografi Anda.</p>
        </section>

        <section class="section reveal">
            {
                photos.length === 0 ? (
                    <div class="empty">
                        <div>
                            <i class="bx bx-camera"></i>
                            <h2>Belum ada foto</h2>
                            <p>Galeri foto akan terhubung ke dashboard admin. Untuk sekarang, biarkan halaman ini kosong.</p>
                            <p class="empty-note">— frame foto akan berserakan di sini —</p>
                        </div>
                    </div>
                ) : (
                    <div class="curated-gallery">
                        {
                            photos.map((photo, i) => {
                                const cls = (i % 4 === 0) ? 'span-2' : (i % 4 === 3) ? 'tall' : '';
                                const batch = JSON.stringify([photo.data.image, ...photo.data.images]);
                                return (
                                    <button type="button" class={`photo-tile reveal ${cls}`} style={`--i: ${i}`} data-batch={batch} data-title={photo.data.title} data-caption={photo.data.caption} data-align={photo.data.align} aria-label={`Buka ${photo.data.title}`}>
                                        <img src={photo.data.image} alt={photo.data.title} loading="lazy" />
                                        <span class="photo-overlay">
                                            <span class="photo-overlay-text">
                                                <strong>{photo.data.title}</strong>
                                                <span>{photo.data.location || fmtDate(photo.data.date)}</span>
                                            </span>
                                        </span>
                                    </button>
                                );
                            })
                        }
                    </div>
                )
            }
        </section>
    </main>

    <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Foto" hidden>
        <button class="lightbox-close" type="button" aria-label="Tutup"><i class="bx bx-x"></i></button>
        <button class="lightbox-nav lightbox-prev" type="button" aria-label="Foto sebelumnya"><i class="bx bx-chevron-left"></i></button>
        <button class="lightbox-nav lightbox-next" type="button" aria-label="Foto berikutnya"><i class="bx bx-chevron-right"></i></button>
        <div class="lightbox-stage">
            <img class="lightbox-img" src="" alt="" />
        </div>
        <div class="lightbox-panel">
            <h2 class="lightbox-title"></h2>
            <p class="lightbox-caption"></p>
            <span class="lightbox-count"></span>
        </div>
    </div>
</BaseLayout>