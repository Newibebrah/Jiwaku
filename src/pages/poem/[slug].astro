---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const poems = await getCollection('poems');
    return poems.map((poem) => ({
        params: { slug: poem.id },
        props: { poem },
    }));
}

const { poem } = Astro.props;
const { Content } = await render(poem);
const fmtDate = (d) => new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---

<BaseLayout page="poem" title={poem.data.title} description={poem.data.excerpt}>
    <main class="wrapper">
        <section class="section reveal">
            <a class="detail-back" href="/poem"><i class="bx bx-chevron-left"></i> Semua Puisi</a>
            <article class="book poem-book">
                <p class="book-kicker">Puisi</p>
                <h1 class="detail-title poem-title">{poem.data.title}</h1>
                <p class="detail-meta"><i class="bx bx-calendar"></i>{fmtDate(poem.data.date)}</p>
                <div class="book-body">
                    <div class="poem-lines" data-align={poem.data.align}><Content /></div>
                </div>
            </article>
        </section>
    </main>
</BaseLayout>