---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const { title = 'JIWAKU', description = '', page = '' } = Astro.props;
const [site] = await getCollection('site');
const siteData = site?.data || {};
const siteTitle = siteData.title || 'JIWAKU';
const siteDescription = siteData.description || 'Ruang untuk puisi, fotografi, dan tulisan.';
const finalTitle = title === 'JIWAKU' ? `${siteTitle} — Puisi, Fotografi & Tulisan` : `${title} — ${siteTitle}`;
const finalDescription = description || siteDescription;
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription}>
    <meta name="generator" content={Astro.generator}>
    <link rel="icon" href="/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@400..700&display=swap" rel="stylesheet">
    <link href="https://cdn.boxicons.com/3.0.8/fonts/basic/boxicons.min.css" rel="stylesheet">
    <link href="https://cdn.boxicons.com/3.0.8/fonts/filled/boxicons-filled.min.css" rel="stylesheet">
    <link href="https://cdn.boxicons.com/3.0.8/fonts/brands/boxicons-brands.min.css" rel="stylesheet">
</head>
<body data-page={page}>
    <Navbar page={page} siteTitle={siteTitle} />
    <slot />

    <Footer siteData={siteData} />

    <div class="spotlight" aria-hidden="true"></div>
    <div class="fragment" aria-live="polite">
        <p></p>
    </div>

    <script>
        import '../scripts/main.js';
    </script>
</body>
</html>
