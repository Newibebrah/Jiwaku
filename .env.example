# Login admin untuk Decap CMS (bukan OAuth GitHub)
# Buat di Vercel > Project > Settings > Environment Variables
ADMIN_USERNAME=
ADMIN_PASSWORD=

# GitHub Personal Access Token (classic, scope: repo) dari akun dengan akses tulis ke repo.
# Dibuat di https://github.com/settings/tokens
# Catatan: token di-env Vercel dikeluarkan server hanya setelah login password benar.
GITHUB_PAT=

# Base URL of the deployed site, e.g. https://jiwaku-ten.vercel.app
# Optional: jika kosong, request host dipakai untuk menentukan redirect default.
OAUTH_BASE_URL=
